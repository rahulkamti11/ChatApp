{
  "expo": {
    "name": "Qwink",
    "slug": "qwink",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "qwink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#128C7E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qwink.app"
    },
    "android": {
      "package": "com.qwink.app"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "plugins": [
      "expo-router",
      "./plugins/withFixedGradle",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9527b143-e302-4e96-ae34-43b6263852bc"
      }
    }
  }
}
